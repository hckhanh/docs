{
  "$schema": "https://context7.com/schema/docs7.json",
  "theme": "mint",
  "name": "Khanh Docs",
  "favicon": "/images/favicon.svg",
  "description": "Documentation for Khanh's open source libraries",
  "seo": {
    "indexing": "navigable",
    "trailingSlash": false,
    "metatags": {
      "canonical": "https://docs.khanh.id",
      "robots": "index, follow",
      "og:site_name": "Khanh Docs",
      "og:locale": "en_US"
    },
    "organization": {
      "name": "Khanh",
      "url": "https://khanh.id",
      "id": "https://khanh.id/#organization",
      "sameAs": [
        "https://github.com/hckhanh"
      ]
    }
  },
  "markdown": {
    "instructions": [
      "This site documents fast-url, format-prompt, ja4, vn-number, what-the-fetch, and Pulumi Any Terraform.",
      "Each library is a separate product. Its pages start at /<library>/overview.",
      "Use only the APIs and fields written on the pages for that library. Do not invent fields.",
      "The Markdown for a page is that path with .md appended.",
      "If a URL is missing, follow the suggested pages or search /search?q= instead of guessing another path.",
      "The published documentation site is https://docs.khanh.id."
    ]
  },
  "colors": {
    "primary": "#0F766E"
  },
  "filterSidebar": true,
  "poweredByDocs7": true,
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/hckhanh"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/hckhanh"
    }
  },
